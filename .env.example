# 複製成 .env 並填入你在 n2yo.com 個人資料頁產生的金鑰
N2YO_API_KEY=
# 以下都可以不填
# 星鏈資料、歷史備份、雲圖歷史放在哪裡（預設 %LOCALAPPDATA%\SatelliteTracker，換新版也會沿用）
# DATA_DIR=
# 雲圖歷史保留幾小時（每 10 分鐘一張，每張約 3.4 MB，24 小時約 490 MB）
# CLOUDS_KEEP_HOURS=24
# 星鏈 TLE 歷史保留幾天
# STARLINK_KEEP_DAYS=30
# 長期收集（氣象測站 CSV、東亞雲圖）保留幾天；不填 = 永久保留
# WEATHER_KEEP_DAYS=
# CLOUDS_ARCHIVE_KEEP_DAYS=
# 東亞雲圖幾分鐘存一張（最少 10）
# CLOUDS_ARCHIVE_EVERY_MIN=60
# 設成 0 就不收集
# COLLECT=1
